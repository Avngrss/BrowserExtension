{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "chrome-types"],
    "paths": {
      "wxt": ["./node_modules/wxt/dist/index.d.mts"]
    }
  },
  "include": ["playwright.config.ts", "tests/extension/**/*.ts"]
}
